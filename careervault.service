[Unit]
Description=CareerVault FastAPI service
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/CareerVault/Dev/backend
EnvironmentFile=/var/www/CareerVault/Dev/backend/.env
ExecStart=/var/www/CareerVault/Dev/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
