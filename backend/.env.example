# CareerVault backend environment variables.
# Copy this file to `.env` and adjust the values:
#
#   cp .env.example .env
#
# The application falls back to sensible development defaults when a
# variable is missing, so the backend can also be started without a
# `.env` file (SQLite will be used as the database).

# Application
APP_NAME=CareerVault
APP_ENV=development
# Keep Swagger, ReDoc, and the OpenAPI schema enabled in development and production.
ENABLE_API_DOCS=true
# Generate a strong random key, e.g. with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace-with-a-secure-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# Database
# PostgreSQL (production / recommended):
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/careervault
# SQLite (quick local development without PostgreSQL):
# DATABASE_URL=sqlite:///./careervault.db

# Frontend
FRONTEND_URL=http://localhost:9000
